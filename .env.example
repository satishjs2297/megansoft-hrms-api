# Auth
SECRET_KEY=your-secret-key-change-in-production
PANEL_SECRET=
ADMIN_SECRET=
AUTH_CONFIG_FILE=app/auth/rbac_config.json
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_SESSION_MAX_DEVICES=10
IDEMPOTENCY_TTL_MINUTES=60
LOGIN_RATE_LIMIT_PER_MINUTE=30
HEAVY_RATE_LIMIT_PER_MINUTE=60

# LLM
LLM_PROVIDER=azure-openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_COMPLETION_TOKENS=4000
LLM_SLOW_LOG_THRESHOLD_SECONDS=8.0
OPENAI_API_KEY=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
ANTHROPIC_API_KEY=

# OCR
USE_OCR=true

# DB
DATABASE_URL=sqlite:///./hrms.db

# CORS — comma-separated list of allowed origins
# Add your Cloud Run UI URL here in production
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:19006,http://localhost:8081
